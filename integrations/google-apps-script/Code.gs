// Pluga11y contact emails. Generated: npm run build:email. No secrets are included.

const PLUGA11Y_LOGO_BASE64 = '';

const SUPPORT_EMAIL = 'gen.praveenthan@gmail.com';
const INQUIRY_TYPES = ['General Enquiry', 'Product Demo', 'Technical Support', 'Accessibility Feedback', 'Partnership', 'Other'];

function validateContact(input) {
  if (!input || typeof input !== 'object' || Array.isArray(input)) throw new Error('invalid');
  const limits = { fullName: [2,120], email: [3,254], organization: [0,120], subject: [3,180], message: [10,5000] };
  const value = {};
  for (const [field, [min,max]] of Object.entries(limits)) {
    if (typeof input[field] !== 'string') throw new Error('invalid');
    value[field] = input[field].trim();
    if (value[field].length < min || value[field].length > max || /[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/.test(value[field])) throw new Error('invalid');
    if (field !== 'message' && /[\r\n]/.test(value[field])) throw new Error('invalid');
  }
  // A single mailbox only. Commas, header delimiters and address lists are rejected.
  if (!/^[A-Za-z0-9.!#$%&'*+\/=?^_`{|}~-]+@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+$/.test(value.email) || /[\s,;<>]/.test(value.email)) throw new Error('invalid');
  if (!INQUIRY_TYPES.includes(input.inquiryType) || input.consent !== true || input.website !== '' || input.source !== 'a11yease-contact') throw new Error('invalid');
  if (!Number.isFinite(input.formDurationMs) || input.formDurationMs < 3000) throw new Error('invalid');
  if (typeof input.requestId !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(input.requestId)) throw new Error('invalid');
  return { ...value, inquiryType: input.inquiryType, requestId: input.requestId };
}



function escapeHtml(value) {
  return String(value).replace(/[&<>"']/g, character => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[character]));
}

function emailShell(heading, preview, content, reference) {
  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${escapeHtml(heading)} | Pluga11y</title></head>
<body style="margin:0;padding:0;background:#F7F9FC;color:#14243C;font-family:Arial,Helvetica,sans-serif;line-height:1.7">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all">${escapeHtml(preview)}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F7F9FC"><tr><td align="center" style="padding:32px 16px">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#FFFFFF;border:1px solid #E2E8F0;border-radius:16px">
<tr><td style="padding:28px 32px;border-bottom:1px solid #E2E8F0"><img src="cid:pluga11yLogo" alt="Pluga11y logo" width="184" height="49" style="display:block;border:0;color:#101D3D;font-size:24px;font-weight:700"></td></tr>
<tr><td style="padding:32px"><p style="margin:0 0 12px;color:#2457C5;font-size:12px;letter-spacing:1.5px;font-weight:700">DIGITAL ACCESSIBILITY, SIMPLIFIED</p><h1 style="margin:0 0 24px;font-size:28px;line-height:1.3;color:#102447">${escapeHtml(heading)}</h1>${content}
<p style="margin:28px 0 0">Warm regards,<br><strong>The Pluga11y Team</strong></p></td></tr>
<tr><td style="padding:24px 32px;background:#EFF5FF;border-radius:0 0 16px 16px;font-size:13px;color:#526176"><p style="margin:0 0 8px">Pluga11y · Accessibility built around you.</p><p style="margin:0"><a href="mailto:${SUPPORT_EMAIL}" style="color:#2457C5;text-decoration:underline">${SUPPORT_EMAIL}</a></p><p style="margin:12px 0 0;overflow-wrap:anywhere">Reference: ${escapeHtml(reference)}</p></td></tr>
</table></td></tr></table></body></html>`;
}

function buildContactEmails(contact) {
  const visitorBody = `Hi ${contact.fullName},\n\nWelcome to Pluga11y, and thank you for contacting us!\n\nWe have received your inquiry. Our team will review your message and get back to you as soon as possible.\n\nYou can reply to this email if you would like to add anything.\n\nWarm regards,\nThe Pluga11y Team\n${SUPPORT_EMAIL}\nReference: ${contact.requestId}`;
  const visitorHtml = emailShell('Thank you for contacting us.', 'Your inquiry has reached Pluga11y. Our team will be in touch as soon as possible.', `<p style="margin:0 0 20px">Hi ${escapeHtml(contact.fullName)},</p><p style="margin:0 0 20px">Welcome to <strong>Pluga11y</strong>, and thank you for getting in touch!</p><div style="padding:20px;background:#EFF5FF;border-left:4px solid #2457C5;border-radius:8px"><p style="margin:0">We have received your inquiry. Our team will review your message and <strong>get back to you as soon as possible.</strong></p></div><p style="margin:20px 0 0">You can reply to this email if you would like to add anything. We look forward to speaking with you.</p><p style="margin:20px 0 0;font-size:13px;color:#526176">This is an automatic acknowledgment of a contact form submission. If you did not contact us, you can disregard this email.</p>`, contact.requestId);
  const rows = [['Name',contact.fullName],['Email',contact.email],['Organization',contact.organization || 'Not supplied'],['Inquiry type',contact.inquiryType],['Subject',contact.subject],['Message',contact.message]];
  const ownerHtml = emailShell('A new conversation starts here.', 'A visitor sent an inquiry through the Pluga11y contact form.', `<p style="margin:0 0 24px">A visitor submitted the Pluga11y contact form. Reply to this email to respond to the visitor.</p><table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;text-align:left">${rows.map(([label,value]) => `<tr><th scope="row" style="padding:12px 8px 12px 0;border-bottom:1px solid #E2E8F0;vertical-align:top;font-size:14px;width:110px">${label}</th><td style="padding:12px 0;border-bottom:1px solid #E2E8F0;overflow-wrap:anywhere;white-space:pre-wrap;font-size:14px">${escapeHtml(value)}</td></tr>`).join('')}</table>`, contact.requestId);
  return {
    owner: { to: SUPPORT_EMAIL, replyTo: contact.email, name: 'Pluga11y', subject: `Pluga11y · ${contact.inquiryType}: ${contact.subject}`, body: `New Pluga11y inquiry\n\n${rows.map(([label,value]) => `${label}: ${value}`).join('\n\n')}\n\nReference: ${contact.requestId}`, htmlBody: ownerHtml },
    visitor: { to: contact.email, replyTo: SUPPORT_EMAIL, name: 'Pluga11y', subject: 'Thank you for contacting Pluga11y', body: visitorBody, htmlBody: visitorHtml },
  };
}


// Built into Code.gs by npm run build:email. Never put the secret in this file.
function authorizeMail() {
  // Run once in the Apps Script editor while signed in as gen.praveenthan@gmail.com.
  return MailApp.getRemainingDailyQuota();
}

function doPost(event) {
  var output = function (data) { return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON); };
  var properties = PropertiesService.getScriptProperties();
  var token = properties.getProperty('CONTACT_SCRIPT_TOKEN');
  var input;
  try {
    if (!event || !event.postData || event.postData.contents.length > 25000) throw new Error('invalid');
    input = JSON.parse(event.postData.contents);
    if (!token || token.length < 32 || input.token !== token) return output({ success:false, code:'unauthorized' });
  } catch (_) { return output({ success:false, code:'invalid' }); }
  var contact;
  try { contact = validateContact(input.contact); } catch (_) { return output({ success:false, code:'invalid' }); }
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) return output({ success:false, code:'busy' });
  try {
    var key = 'inquiry:' + contact.requestId;
    var state = properties.getProperty(key);
    if (state) {
      var previous = JSON.parse(state);
      if (previous.ownerAccepted) return output({ success:true, ownerAccepted:true, confirmationAccepted:previous.confirmationAccepted === true });
      // A previous invocation may have stopped after handing the email to Gmail.
      // Never resend it automatically: Gmail cannot provide an atomic send-and-save.
      return output({ success:false, code:'delivery-unknown' });
    }
    var now = Date.now();
    var all = properties.getProperties();
    Object.keys(all).filter(function (name) { return name.indexOf('inquiry:') === 0; }).forEach(function (name) {
      try { if (now - JSON.parse(all[name]).at > 86400000) properties.deleteProperty(name); } catch (_) { properties.deleteProperty(name); }
    });
    var cache = CacheService.getScriptCache();
    var digest = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, contact.email.toLowerCase());
    var recipientKey = 'recipient:' + Utilities.base64EncodeWebSafe(digest);
    var attempts = Number(cache.get(recipientKey) || 0);
    if (attempts >= 3) return output({ success:false, code:'rate-limit' });
    if (MailApp.getRemainingDailyQuota() < 2) return output({ success:false, code:'quota' });
    cache.put(recipientKey, String(attempts + 1), 3600);
    var messages = buildContactEmails(contact);
    var inlineImages = { pluga11yLogo: Utilities.newBlob(Utilities.base64Decode(PLUGA11Y_LOGO_BASE64), 'image/png', 'pluga11y-logo.png') };
    properties.setProperty(key, JSON.stringify({ at:now, ownerAccepted:false, confirmationAccepted:false }));
    try {
      MailApp.sendEmail(Object.assign({}, messages.owner, { inlineImages:inlineImages }));
    } catch (_) { return output({ success:false, code:'delivery-unknown' }); }
    properties.setProperty(key, JSON.stringify({ at:now, ownerAccepted:true, confirmationAccepted:false }));
    try {
      MailApp.sendEmail(Object.assign({}, messages.visitor, { inlineImages:inlineImages }));
      properties.setProperty(key, JSON.stringify({ at:now, ownerAccepted:true, confirmationAccepted:true }));
      return output({ success:true, ownerAccepted:true, confirmationAccepted:true });
    } catch (_) {
      // The inquiry is already accepted. Do not ask the visitor to submit it again.
      return output({ success:true, ownerAccepted:true, confirmationAccepted:false });
    }
  } catch (_) { return output({ success:false, code:'delivery-unknown' }); }
  finally { lock.releaseLock(); }
}
